layout_mode = 2
text = "🚀 Play Again"

[node name="PlacementDialog" type="PanelContainer" parent="Control"]
visible = false
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -210.0
offset_top = -110.0
offset_right = 210.0
offset_bottom = 110.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")

[node name="Margin" type="MarginContainer" parent="Control/PlacementDialog"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="Control/PlacementDialog/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Control/PlacementDialog/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.247059, 0.815686, 0.941176, 1)
theme_override_font_sizes/font_size = 14
text = "📍 RECORD SURFACE LOCATION (KEY P)"
horizontal_alignment = 1

[node name="CoordsLabel" type="Label" parent="Control/PlacementDialog/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.85, 0.95, 0.8)
theme_override_font_sizes/font_size = 11
text = "Position: (0.0, 0.0, 0.0)"
horizontal_alignment = 1

[node name="NameInput" type="LineEdit" parent="Control/PlacementDialog/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
placeholder_text = "Enter marker name (e.g. oxygen_cache)..."
clear_button_enabled = true

[node name="BtnBox" type="HBoxContainer" parent="Control/PlacementDialog/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="SaveBtn" type="Button" parent="Control/PlacementDialog/Margin/VBox/BtnBox"]
layout_mode = 2
size_flags_horizontal = 3
text = "💾 Save Location"

[node name="CancelBtn" type="Button" parent="Control/PlacementDialog/Margin/VBox/BtnBox"]
layout_mode = 2
size_flags_horizontal = 3
text = "Cancel"

[connection signal="pressed" from="Control/PauseMenu/Margin/VBox/ResumeBtn" to="." method="toggle_pause"]
[connection signal="pressed" from="Control/LorePopup/Margin/VBox/CloseLoreBtn" to="." method="close_lore_popup"]
[connection signal="pressed" from="Control/DeathScreen/Margin/VBox/RestartBtn" to="." method="_on_restart_pressed"]
[connection signal="pressed" from="Control/WinScreen/Margin/VBox/WinRestartBtn" to="." method="_on_restart_pressed"]
